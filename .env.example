# AI Studio Environment Configuration
DISABLE_HMR=false

# ==========================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==========================================
# The public URL of your Railway backend service (e.g. https://airsync-backend.up.railway.app)
# Leave empty or omit if frontend and backend are served from the same domain.
VITE_API_URL=https://your-railway-backend.up.railway.app

# ==========================================
# 2. BACKEND ENVIRONMENT VARIABLES (Railway)
# ==========================================
# Railway automatically assigns PORT. Default fallback is 3000.
PORT=3000

# Node environment mode: production
NODE_ENV=production

# (Optional) Restrict CORS to your specific Vercel frontend URL:
# FRONTEND_URL=https://your-project.vercel.app
